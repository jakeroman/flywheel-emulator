{
  "name": "flywheel-emulator",
  "private": true,
  "version": "0.0.0",
  "description": "Web-based emulator and development environment for the Flywheel handheld (ESP32-S3).",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @flywheel/web",
    "build": "npm run build --workspace @flywheel/web",
    "preview": "npm run preview --workspace @flywheel/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,css}\"",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vitest": "^3.0.0",
    "wabt": "^1.0.39"
  },
  "engines": {
    "node": ">=20"
  }
}
